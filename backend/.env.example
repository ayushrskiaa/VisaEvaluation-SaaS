# Backend
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/visa-eval
MAX_SCORE_CAP=85

# AI Integration (optional) - Using Gemini
# Prefer GEMINI_API_KEY. GOOGLE_API_KEY is also supported.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
